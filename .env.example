# --- Immich ---
IMMICH_URL=http://immich-server:2283
# Where people open Immich in their browser (links on the setup page); defaults to IMMICH_URL
IMMICH_PUBLIC_URL=https://photos.example.com

# --- Self-service setup at PUBLIC_URL/setup/ ---
# Sign-in through your OIDC provider (e.g. Pocket ID): register Mail-A-Patatina as its own client with the
# callback URL PUBLIC_URL/setup/callback and the scopes openid, email, profile. Without OIDC, people sign in
# with one of their Immich API keys instead.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Pocket ID
# "Connect with Immich" and invite links: keys are created by signing in to Immich (Immich's own OAuth login)
# instead of being created and pasted by hand. Used automatically while Immich has OAuth login switched on.
# Allow PUBLIC_URL/setup/immich-callback as a callback URL of IMMICH's client at the provider (not
# Mail-A-Patatina's), or set this to false. Pasting a key by hand stays possible either way.
IMMICH_OAUTH_CONNECT=true
# Families set up on the page are saved here (one file each, they contain API keys)
SETUP_DIR=/secrets/feeds
# Who hears about relatives waiting for approval (`approve`) or in no album anymore (`forget`), comma-separated
INSTALL_ADMIN_EMAILS=
# Admin key, only used by the approve / add-relative / add-bot / forget commands (adminUser.read, adminUser.create,
# adminUser.update, and adminUser.delete for `forget`;
# plus adminConfig.read + adminConfig.update on OAuth-only servers, so password login can be switched on for a few
# seconds while an account is set up). Leave this EMPTY and pass it only when running those commands:
#   docker compose run --rm -e IMMICH_ADMIN_API_KEY=... app python -m mail_a_patatina add-relative ...
IMMICH_ADMIN_API_KEY=

# --- Optional: families defined by the admin instead of on the setup page ---
# One family: set these. Several: leave ALBUM_ID empty and list them in config/feeds.yml.
# (see feeds.example.yml; anything a feed doesn't set falls back to the values in this file).
# The family's pages live under PUBLIC_URL/<FEED_ID>/.
FEED_ID=family
# The shared album (the UUID in its URL). Its members are the email recipients.
ALBUM_ID=
# Album owner's API key. Permissions: album.read, asset.read, asset.view, asset.update (delivery markers),
# activity.read, user.read, albumUser.create (add-relative/add-bot), albumUser.delete (removing people)
IMMICH_API_KEY=
# Keys of co-parents who add their own photos to the album, created in THEIR Immich account, comma-separated.
# Permissions: user.read, asset.read, asset.update (the delivery marker on their photos)
IMMICH_CONTRIBUTOR_KEYS=
# Chats that get every moment (see chats.example.yml)
CHATS_FILE=/config/chats.yml
# The account that group-chat visitors post as (several families: one per feed, set automatically)
BOT_EMAIL=family-chat@mail-a-patatina.invalid

# --- Defaults for every family ---
SITE_TITLE=Family Feed
TZ=Europe/Berlin
SEND_TIME=07:00
# digest = everything new since yesterday; drip = one moment per day from the queue
SEND_MODE=digest
# Only send photos that have a description in Immich (it becomes the caption). Writing it is the "publish" step.
REQUIRE_CAPTION=true
# Default for every family (each can change it on the setup page): never attach photos to emails or chat messages.
# Emails then load each photo from PUBLIC_URL through a link that works for PHOTO_LINK_DAYS, and only while the photo
# and the recipient are still in the album; chats get the caption and a link. Signs nobody in. false = attach them.
KEEP_PHOTOS_ON_SERVER=true
PHOTO_LINK_DAYS=30
# On the very first run, also send everything already in the album (default: only new from now on).
SEND_BACKLOG=false
# Get an email when someone comments (comma-separated, optional)
ADMIN_EMAILS=
BOT_NAME=Family chat

# --- Identity ---
# Signs magic links and derives the relatives' Immich passwords (only used while add-relative runs, or at
# runtime on servers that allow password login). `openssl rand -base64 48`
SECRET_KEY=
# Where add-relative stores each relative's own Immich API key (mounted from ./secrets; shared by all families).
KEYS_FILE=/secrets/relatives.yml
# Bump to invalidate every magic link at once (keys and passwords are unaffected).
LINK_VERSION=1
# Links in emails sign someone in for this many days, so a forwarded email soon stops working. An expired
# link offers to email a fresh one, only ever to the relative's own address.
LINK_DAYS=7
# The same for links posted in group chats (these can't be renewed by email; newer posts bring new ones).
CHAT_LINK_DAYS=30
# Once a link was opened, that browser stays signed in this long, renewed with every visit.
SESSION_DAYS=90
# Accounts created by add-relative/add-bot are named "<prefix>Oma Erika" in Immich (pages and emails drop the prefix).
# They can't upload anything: their storage quota is 0.
USER_PREFIX=patatina-

# --- Website ---
PUBLIC_URL=https://family.example.com

# --- Schedule ---
SYNC_MINUTES=15
# Wait this long after a photo becomes shareable, so you can still fix a typo in the caption.
SETTLE_MINUTES=30
# Failed sends are retried, and new album members catch up, for moments first sent within this window.
RESEND_HOURS=48

# --- Email ---
SMTP_HOST=smtp.example.com
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sending address. Each family's emails show the family's title as the sender's name
# (feeds.yml can override that per feed with smtp_from); this name is used only for notices to the admin.
SMTP_FROM=Mail-A-Patatina <family@example.com>

# --- WhatsApp via GOWA (compose profile "whatsapp") ---
# Each family links a WhatsApp account of its own on the setup page; the installation has no number of its own.
WHATSAPP_URL=http://whatsapp:3000
WHATSAPP_AUTH=admin:change-me
# Only for families defined in .env / feeds.yml: the gateway device they send from (empty: its only device).
# feeds.yml can also set whatsapp_device per feed.
WHATSAPP_DEVICE_ID=

# --- Signal via signal-cli-rest-api (compose profile "signal") ---
SIGNAL_URL=http://signal:8080
SIGNAL_NUMBER=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
